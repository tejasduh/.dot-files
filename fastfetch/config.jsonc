{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#800000",
      "2": "#FFFFFF"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " → ",
    "color": {
      "keys": "#FFFFFF",
      "title": "#800000"
    },
    "percent": {
      "type": 9
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇  OS"
    },
    {
      "type": "host",
      "key": "  Host"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "uptime",
      "key": "  Uptime"
    },
    {
      "type": "packages",
      "key": "  Packages"
    },
    {
      "type": "shell",
      "key": "  Shell"
    },
    {
      "type": "wm",
      "key": "  WM"
    },
    {
      "type": "de",
      "key": "  DE"
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    }, {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "gpu",
      "key": "  GPU"
    },
    {
      "type": "memory",
      "key": "  Memory"
    },
    {
      "type": "swap",
      "key": "  Swap"
    },
    {
      "type": "disk",
      "key": "  Disk"
    },
    {
      "type": "battery",
      "key": "  Battery"
    },
    {
      "type": "poweradapter",
      "key": "  Power"
    },
    {
      "type": "localip",
      "key": "  Local IP"
    },
    {
      "type": "wifi",
      "key": "  Wi-Fi"
    },
    {
      "type": "player",
      "key": "  Player"
    },
    {
      "type": "media",
      "key": "  Media"
    },
    "colors"
  ]
}
