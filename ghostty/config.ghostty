command = fish 

# Font Settings (Claude's Monospace Stack)
# font-family = "Söhne Mono"
font-family = "SF Mono"
font-size = 13
adjust-cell-height = 10%

# Window & Aesthetics
#window-padding-x = 10 
#window-padding-y = 10 
window-decoration = true
window-theme = dark
window-colorspace = display-p3

mouse-hide-while-typing = true

# Transparency & Blur
background-opacity = 0.75
# Note: On Linux, Ghostty provides the transparency, but the actual "blur" effect 
# is handled by your compositor (e.g., Picom, Hyprland, KDE KWin). Make sure 
# window blurring is enabled in your compositor settings for this to take effect!
background-blur = true
background-blur-radius = 50 

# Cursor Settings
cursor-style = bar
cursor-style-blink = true
cursor-color = "#e5748b"
cursor-text = "#140c10"

palette = 0=#26233a
palette = 1=#eb6f92
palette = 2=#ca3a54
palette = 3=#f6c177
palette = 4=#b03060
palette = 5=#c4a7e7
palette = 6=#ebbcba
palette = 7=#e0def4
palette = 8=#6e6a86
palette = 9=#eb6f92
palette = 10=b3124b
palette = 11=#f6c177
palette = 12=#b03060
palette = 13=#c4a7e7
palette = 14=#ebbcba
palette = 15=#e0def4
background = #0f1024
foreground = #e0def4
#cursor-color = #e0def4
#cursor-text = #191724
selection-background = #403d52
selection-foreground = #e0def4



